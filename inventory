function stock(v){return selected.tx.filter(t=>t.v===v.id).reduce((n,t)=>n+(t.type==='입고'?t.qty:-t.qty),v.initial)}
function render(){const q=$('search').value.toLowerCase();$('productCount').textContent=data.length+'개';$('products').innerHTML=data.filter(p=>p.name.toLowerCase().includes(q)).map(p=>`<button class="product ${p===selected?'active':''}" data-product="${p.id}">${esc(p.name)}<small>${esc(p.id)}</small></button>`).join('')||'<p class="empty">검색 결과가 없어요.</p>';$('productName').textContent=selected.name;$('productCode').textContent=selected.id;const total=selected.versions.reduce((n,v)=>n+stock(v),0),avail=selected.versions.filter(v=>v.state!=='사용 중지').reduce((n,v)=>n+stock(v),0);$('total').innerHTML=fmt(total)+'<small>장</small>';$('available').innerHTML=fmt(avail)+'<small>장</small>';$('versionCount').innerHTML=selected.versions.length+'<small>개</small>';$('versions').innerHTML=selected.versions.map(v=>`<article class="version"><div class="version-top"><span>${esc(v.id)}</span><span class="state ${v.state==='사용 중지'?'blocked':v.state==='소진 후 종료'?'old':''}">${esc(v.state)}</span></div><p>${esc(v.note)}</p><div class="version-bottom"><strong>${fmt(stock(v))}<small>장</small></strong><button data-record="${esc(v.id)}">입출고 기록</button></div></article>`).join('');const old=$('filter').value;$('filter').innerHTML='<option value="">모든 버전</option>'+selected.versions.map(v=>`<option>${esc(v.id)}</option>`).join('');if(selected.versions.some(v=>v.id===old))$('filter').value=old;renderHistory()}
function renderHistory(){const list=selected.tx.filter(t=>!$('filter').value||t.v===$('filter').value).slice().sort((a,b)=>b.date.localeCompare(a.date));$('history').innerHTML=list.map(t=>`<tr><td>${esc(t.date.replaceAll('-','.'))}</td><td><span class="tx ${t.type==='출고'?'out':''}">${esc(t.type)}</span></td><td>${esc(t.v)}</td><td class="num">${t.type==='입고'?'+':'−'}${fmt(t.qty)}</td><td>${esc(t.person)}</td><td>${esc(t.note)||'—'}</td></tr>`).join('')||'<tr><td colspan="6" class="empty">아직 입출고 기록이 없습니다.</td></tr>'}
function field(label,html){return `<label class="field"><span>${label}</span>${html}</label>`}
function openForm(kind,v=null){mode=kind;fixedVersion=v;$('error').textContent='';$('modalProduct').textContent=selected.name;$('modalTitle').textContent=kind==='version'?'새 버전 추가':'입출고 기록';const today=new Date().toLocaleDateString('sv-SE',{timeZone:'Asia/Seoul'});$('fields').innerHTML=kind==='version'?field('버전 이름',`<input name="version" required maxlength="30" placeholder="예: V03" value="V${String(selected.versions.length+1).padStart(2,'0')}">`)+field('변경 내용','<input name="note" required maxlength="100" placeholder="예: 라벨 뒷면 표기 수정">')+field('사용 상태','<select name="state"><option>사용 가능</option><option>소진 후 종료</option><option>사용 중지</option></select>')+'<p class="eyebrow">재고 0장으로 등록됩니다. 실제 입고는 입고 기록으로 남겨주세요.</p>':field('버전',`<select name="version">${selected.versions.map(x=>`<option value="${esc(x.id)}" ${x.id===v?'selected':''}>${esc(x.id)} · ${esc(x.state)}</option>`).join('')}</select>`)+`<div class="row">${field('구분','<select name="type"><option>입고</option><option>출고</option></select>')}${field('수량 (장)','<input name="qty" type="number" min="1" step="1" required placeholder="0">')}</div>`+field('날짜',`<input name="date" type="date" required value="${today}">`)+field('담당자','<input name="person" required maxlength="30" placeholder="이름 입력">')+field('비고','<input name="note" maxlength="100" placeholder="예: 생산 사용 / 업체 납품">');$('modal').showModal()}
$('products').onclick=e=>{const b=e.target.closest('[data-product]');if(b){selected=data.find(p=>p.id===b.dataset.product);$('filter').value='';render()}};$('versions').onclick=e=>{const b=e.target.closest('[data-record]');if(b)openForm('record',b.dataset.record)};$('search').oninput=render;$('filter').onchange=renderHistory;$('recordBtn').onclick=()=>openForm('record');$('versionBtn').onclick=()=>openForm('version');$('close').onclick=$('cancel').onclick=()=>$('modal').close();$('form').onsubmit=e=>{e.preventDefault();const f=Object.fromEntries(new FormData(e.target));if(mode==='version'){const id=f.version.trim();if(!id||selected.versions.some(v=>v.id.toLowerCase()===id.toLowerCase())){$('error').textContent='다른 버전 이름을 입력해주세요.';return}selected.versions.push({id,note:f.note.trim(),state:f.state,initial:0})}else{const qty=Number(f.qty),v=selected.versions.find(x=>x.id===f.version);if(!Number.isSafeInteger(qty)||qty<=0){$('error').textContent='수량은 1 이상의 정수로 입력해주세요.';return}if(f.type==='출고'&&v.state==='사용 중지'){$('error').textContent='사용 중지된 버전은 출고할 수 없습니다.';return}if(f.type==='출고'&&qty>stock(v)){$('error').textContent=`현재 재고는 ${fmt(stock(v))}장입니다. 출고 수량을 확인해주세요.`;return}if(!f.person.trim()){$('error').textContent='담당자 이름을 입력해주세요.';return}selected.tx.push({date:f.date,type:f.type,v:f.version,qty,person:f.person.trim(),note:f.note.trim()})}$('modal').close();render();$('toast').textContent=mode==='version'?'새 버전이 제품에 추가되었습니다.':'기록을 저장하고 재고를 반영했습니다.';$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),2500)};render();
</script><script>const materials=[{id:'cap',name:'20파이 검정 안전캡 (호리병용)',unit:'개',versions:[{id:'공용',qty:1000}]},{id:'bottle',name:'50ml 투명 호리유리병',unit:'개',versions:[{id:'공용',qty:1000}]},{id:'suede',name:'스웨이드 3P',unit:'세트',versions:[{id:'공용',qty:900}]},{id:'label',name:'나노코트 V3 50ml 전/후면 라벨',unit:'세트',versions:[{id:'V01',qty:180},{id:'V02',qty:600}]},{id:'case',name:'나노코트 V3 50ml 케이스',unit:'개',versions:[{id:'V01',qty:160},{id:'V02',qty:600}]},{id:'insert',name:'파이어볼 유리막 50ml 속지',unit:'개',versions:[{id:'공용',qty:1000}]},{id:'block',name:'파이어볼 코팅블럭',unit:'개',versions:[{id:'공용',qty:1000}]}];
const boms=[{id:'BOM 01',name:'기존 포장 구성',locked:true,lines:materials.map(m=>({mid:m.id,v:m.versions[0].id,qty:1}))},{id:'BOM 02',name:'라벨·케이스 변경 구성',locked:false,lines:materials.map(m=>({mid:m.id,v:m.versions.at(-1).id,qty:1}))}];let activeBom=1;const productions=[],materialTransactions=[];let finished=0;const surface=$('productionSurface');
function requirement(bom,n){return bom.lines.map(l=>{const m=materials.find(x=>x.id===l.mid),v=m.versions.find(x=>x.id===l.v);return {m,v,needed:l.qty*n}})}
function completeProduction(bom,n,person){if(!Number.isSafeInteger(n)||n<=0)throw Error('생산 수량은 1 이상의 정수로 입력해주세요.');if(!person.trim())throw Error('담당자 이름을 입력해주세요.');const req=requirement(bom,n);if(req.some(x=>x.v.qty<x.needed))throw Error('부족한 부자재가 있습니다. 입고 후 생산을 등록해주세요.');const id='생산 '+String(productions.length+1).padStart(3,'0');const date=new Date().toLocaleDateString('sv-SE',{timeZone:'Asia/Seoul'});const snapshot=req.map(x=>({material:x.m.name,mid:x.m.id,v:x.v.id,qty:x.needed}));req.forEach(x=>x.v.qty-=x.needed);finished+=n;bom.locked=true;productions.unshift({id,date,bom:bom.id,name:bom.name,n,person:person.trim(),snapshot,cancelled:false});snapshot.forEach(x=>materialTransactions.unshift({date,type:'생산 사용',...x,source:id}));return id}
function cancelProduction(id){const p=productions.find(x=>x.id===id);if(!p||p.cancelled)return;p.snapshot.forEach(x=>{materials.find(m=>m.id===x.mid).versions.find(v=>v.id===x.v).qty+=x.qty;materialTransactions.unshift({date:new Date().toLocaleDateString('sv-SE',{timeZone:'Asia/Seoul'}),type:'생산 취소 복원',...x,source:id})});finished-=p.n;p.cancelled=true}
function renderBom(){const b=boms[activeBom];surface.innerHTML=`<div class="sectionhead"><div><p class="eyebrow">완제품 · 포장 구성</p><h2>파이어볼 나노코트 V3 50ml</h2></div><button id="copyBom">＋ 현재 BOM 복사</button></div><div class="bomlayout"><div><div class="bomcontrols"><select id="bomSelect" aria-label="BOM 선택">${boms.map((x,i)=>`<option value="${i}" ${i===activeBom?'selected':''}>${esc(x.id)} · ${esc(x.name)}</option>`).join('')}</select></div>${b.locked?'<div class="locked">확정된 구성입니다. 변경할 때는 현재 BOM을 복사해 새 구성을 만드세요.</div>':'<div class="locked">편집 가능한 구성입니다. 생산에 사용하면 구성 변경이 잠깁니다.</div>'}<div class="tablewrap"><table class="bomedit"><thead><tr><th>구성품</th><th>부자재 버전</th><th>개당 수량</th><th class="num">현재 재고</th><th class="num">필요 수량</th></tr></thead><tbody>${b.lines.map((l,i)=>{const m=materials.find(x=>x.id===l.mid),v=m.versions.find(x=>x.id===l.v);return `<tr><td>${esc(m.name)}</td><td>${b.locked?esc(l.v):`<select data-line="${i}" aria-label="${esc(m.name)} 버전">${m.versions.map(v=>`<option ${v.id===l.v?'selected':''}>${esc(v.id)}</option>`).join('')}</select>`}</td><td>${b.locked?l.qty:`<input data-qty="${i}" type="number" min="1" step="1" value="${l.qty}" aria-label="${esc(m.name)} 개당 수량">`}</td><td class="num">${fmt(v.qty)} ${m.unit}</td><td class="num" data-needed="${i}"></td></tr>`}).join('')}</tbody></table></div></div><form id="productionForm" class="productionbox"><h3>생산 등록</h3>${field('생산 수량 (세트)','<input id="productionQty" type="number" min="1" step="1" value="100" required>')}${field('담당자','<input id="productionPerson" placeholder="담당자 이름" required maxlength="30">')}<p class="bomsummary">선택한 ${esc(b.id)} 구성으로 부자재를 차감하고 완제품 재고를 추가합니다.</p><p id="productionError" role="alert" style="color:#ba2229;font-size:14px"></p><button type="submit" class="primary">생산 완료 등록</button><strong>${fmt(finished)} <small style="font-size:14px">세트</small></strong><span class="bomsummary">이번 시연에서 생산한 완제품 재고</span></form></div><div class="productionhistory"><div class="sectionhead"><h3>생산 내역</h3><span class="bomsummary">생산 시점의 BOM 구성 보존</span></div><div class="tablewrap"><table><thead><tr><th>생산 번호</th><th>BOM</th><th>수량</th><th>담당자</th><th>상태</th><th>처리</th></tr></thead><tbody>${productions.map(p=>`<tr><td>${p.id}</td><td>${esc(p.bom)} · ${esc(p.name)}</td><td>${fmt(p.n)}세트</td><td>${esc(p.person)}</td><td>${p.cancelled?'취소됨':'완료'}</td><td>${p.cancelled?'—':`<button data-cancel-production="${p.id}">취소·재고 복원</button>`}</td></tr>`).join('')||'<tr><td colspan="6" class="empty">생산 수량과 담당자를 입력해 등록해보세요.</td></tr>'}</tbody></table></div></div><div class="productionhistory"><div class="sectionhead"><h3>자동 생성된 부자재 입출고</h3></div><div class="tablewrap"><table><thead><tr><th>구분</th><th>부자재</th><th>버전</th><th>수량</th><th>연결된 생산</th></tr></thead><tbody>${materialTransactions.map(t=>`<tr><td>${t.type}</td><td>${esc(t.material)}</td><td>${esc(t.v)}</td><td>${t.type==='생산 사용'?'−':'+'}${fmt(t.qty)}</td><td>${t.source}</td></tr>`).join('')||'<tr><td colspan="5" class="empty">생산 등록 시 구성품별 출고가 자동 기록됩니다.</td></tr>'}</tbody></table></div></div>`;$('bomSelect').onchange=e=>{activeBom=Number(e.target.value);renderBom()};$('copyBom').onclick=()=>{const n=boms.length+1;boms.push({id:'BOM '+String(n).padStart(2,'0'),name:'복사한 구성 '+n,locked:false,lines:structuredClone(b.lines)});activeBom=boms.length-1;renderBom()};surface.querySelectorAll('[data-line]').forEach(x=>x.onchange=()=>{b.lines[Number(x.dataset.line)].v=x.value;renderBom()});surface.querySelectorAll('[data-qty]').forEach(x=>x.onchange=()=>{const n=Number(x.value);if(Number.isSafeInteger(n)&&n>0)b.lines[Number(x.dataset.qty)].qty=n;renderBom()});$('productionQty').oninput=updateNeeds;$('productionForm').onsubmit=e=>{e.preventDefault();try{completeProduction(b,Number($('productionQty').value),$('productionPerson').value);renderBom()}catch(e){$('productionError').textContent=e.message}};surface.querySelectorAll('[data-cancel-production]').forEach(x=>x.onclick=()=>{cancelProduction(x.dataset.cancelProduction);renderBom()});updateNeeds()}
function updateNeeds(){const b=boms[activeBom],n=Number($('productionQty').value);requirement(b,Number.isSafeInteger(n)&&n>0?n:0).forEach((x,i)=>{const cell=surface.querySelector(`[data-needed="${i}"]`);cell.textContent=fmt(x.needed)+' '+x.m.unit+(x.needed>x.v.qty?' · 부족':'');cell.style.color=x.needed>x.v.qty?'#ba2229':'#545d6a'})}
$('nav').onclick=e=>{const tab=e.target.dataset.tab;if(!tab)return;surface.hidden=tab!=='bom';$('materialsSurface').hidden=tab!=='materials';$('nav').querySelectorAll('button').forEach(b=>b.classList.toggle('primary',b.dataset.tab===tab))};$('materialsSurface').hidden=true;renderBom();
</script>
</body></html>
